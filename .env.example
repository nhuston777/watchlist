# Neon Postgres. The app uses the pooled string (host contains "-pooler").
# For `npx prisma db push`, run with DATABASE_URL set to the direct string (same host without "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# scrypt hash of the passcode ("salt:hash"). Generate with: npm run hash-passcode
APP_PASSCODE_HASH=""

# TMDB API key (v3) or read access token (v4)
TMDB_KEY=""

# Personal OMDb key (https://www.omdbapi.com/apikey.aspx), used for Rotten Tomatoes / IMDb ratings
OMDB_KEY=""

# Authorizes the daily Vercel Cron refresh. Generate with: openssl rand -hex 32
CRON_SECRET=""

# Only for the one-time Notion import script; not needed in Vercel
NOTION_TOKEN=""
